---
// Fonts served by the site itself (Latin subset only): no external stylesheet blocking first paint
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import serifDisplay from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import sansBody from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';
import '../styles/global.css';
import { site as s } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Fixed from '../components/Fixed.astro';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, e.g. "/cardapio/" */
  path?: string;
  /** Images to fetch early (e.g. the hero pizza on the home page) */
  preloadImages?: string[];
}
const { title, description = s.seo.description, path = '/', preloadImages = [] } = Astro.props;
const pageTitle = title ? `${title} — ${s.name}` : s.seo.title;
const origin = (Astro.site?.href ?? '').replace(/\/$/, '');
const url = `${origin}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: s.name,
  description: s.seo.description,
  url: `${origin}/`,
  image: `${origin}/og.jpg`,
  telephone: s.contact.phoneHref,
  email: s.contact.email,
  priceRange: s.priceRange,
  servesCuisine: ['Pizza'],
  areaServed: s.contact.serviceArea,
  hasMenu: `${origin}/cardapio/`,
  sameAs: Object.values(s.contact.social).filter(Boolean),
  address: { '@type': 'PostalAddress', streetAddress: s.popup.addressLines[0], addressLocality: s.city, addressCountry: 'BR' },
  openingHoursSpecification: s.hours.flatMap((h, d) =>
    h ? [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][d], opens: h[0], closes: h[1] }] : []
  ),
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#0f0c0b" />
    <meta name="color-scheme" content="dark" />
    {s.mockupNotice && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={s.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${origin}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${s.name} — ${s.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Photos come from the Unsplash CDN; no crossorigin, images are requested without CORS -->
    <link rel="preconnect" href="https://images.unsplash.com" />
    {preloadImages.map((src) => <link rel="preload" as="image" href={src} type="image/webp" fetchpriority="high" />)}
    {path === '/' && (
      <>
        <link rel="preload" as="image" href="/video/hero-poster.webp" type="image/webp" media="(min-width: 900px)" fetchpriority="high" />
        <link rel="preload" as="image" href="/video/hero-poster-sm.webp" type="image/webp" media="(max-width: 899px)" fetchpriority="high" />
      </>
    )}
    {path !== '/' && (
      <>
        <link rel="preload" as="image" href="/img/pizza-top.webp" type="image/webp" media="(min-width: 900px)" />
        <link rel="preload" as="image" href="/img/pizza-top-sm.webp" type="image/webp" media="(max-width: 899px)" />
      </>
    )}
    <link rel="preload" href={serifDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansBody} as="font" type="font/woff2" crossorigin />

    <!-- Motion only when the visitor allows it; if the script fails, everything shows after 4 s -->
    <script is:inline>
      (function (d) {
        d.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        setTimeout(function () { if (!window.__motionReady) d.classList.remove('motion'); }, 4000);
      })(document.documentElement);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#content">Pular para o conteúdo</a>
    {s.mockupNotice && <aside class="mockup-ribbon" aria-label="Aviso de site modelo"><p><strong>Site modelo</strong> · marca, cardápio, preços e contatos fictícios</p></aside>}
    <Header path={path} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Fixed />
    <script type="application/json" id="site-data" set:html={JSON.stringify({ timezone: s.timezone, popup: { weekday: s.popup.weekday, open: s.popup.open, close: s.popup.close }, hours: s.hours, endpoint: s.quoteForm.endpoint })} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
