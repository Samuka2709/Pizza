---
import { site as s } from '../data/site';
import { photoUrl, photoSrcset } from '../lib/img';
import SectionLabel from './SectionLabel.astro';
import Icon from './Icon.astro';
const f = s.film;
const poster = f.poster.id ? photoUrl(f.poster.id, 1600, 16 / 9, 75) : undefined;
---
<section class="section film" aria-labelledby="film-title">
  <div class="container">
    <div class="film__head">
      <SectionLabel num="02" text="O vídeo" />
      <h2 class="display h2 reveal-words" id="film-title" data-split-auto>{f.title}</h2>
      <p class="lead" data-reveal="fade">{f.text}</p>
    </div>

    <!-- Brand video slot: fixed 16:9 frame, so adding the video never changes the layout -->
    <div class="film__frame" data-film data-reveal="fade">
      {f.src ? (
        <video class="film__video" controls preload="none" playsinline poster={poster}>
          <source src={f.src} type="video/mp4" />
        </video>
      ) : (
        <div class="film__placeholder" role="img" aria-label="Espaço reservado para o vídeo da marca">
          {f.poster.id && (
            <img class="film__poster" src={photoUrl(f.poster.id, 960, 16 / 9)} srcset={photoSrcset(f.poster.id, 16 / 9, [640, 960, 1400, 1920])} sizes="(min-width: 1400px) 1300px, 100vw" width="960" height="540" alt="" loading="lazy" decoding="async" />
          )}
          <span class="film__play" aria-hidden="true"><Icon name="play" /></span>
          <span class="film__soon">Vídeo da marca · em breve</span>
          <span class="film__spec" aria-hidden="true">16:9 · MP4 · entra neste quadro</span>
        </div>
      )}
    </div>
  </div>
</section>
