---
import { site as s, type Diet } from '../data/site';
import { price } from '../lib/format';

const dietLabel = (d: Diet) => s.dietKey.find((k) => k.code === d)!.label;
---
<div class="tabs" data-tabs>
  <div class="tabs__scroller">
    <div class="tabs__list" role="tablist" aria-label="Menu sections">
      {s.menu.map((c, i) => (
        <button class="tab" type="button" role="tab" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          {c.label}
        </button>
      ))}
      <button class="tab" type="button" role="tab" id="tab-dietary" aria-controls="panel-dietary" aria-selected="false" tabindex="-1">Dietary info</button>
      <span class="tabs__indicator" aria-hidden="true"></span>
    </div>
  </div>
</div>

<div class="menu-panels">
  {s.menu.map((c, i) => (
    <div class="menu-panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} tabindex="0" hidden={i !== 0}>
      <h2 class="sr-only">{c.label}</h2>
      {c.note && <p class="menu-panel__note">{c.note}</p>}
      <ul class="menu-list">
        {c.items.map((d) => (
          <li class:list={['menu-row', { 'menu-row--signature': d.signature }]}>
            <div class="menu-row__top">
              <h3 class="menu-row__name">{d.name}</h3>
              {d.signature && <span class="tag">House favourite</span>}
              <span class="menu-row__leader" aria-hidden="true"></span>
              <p class="price">{price(d.price)}</p>
            </div>
            <p class="menu-row__desc">{d.description}</p>
            {d.diet && (
              <p class="menu-row__diet">
                {d.diet.map((x) => <abbr class="diet" title={dietLabel(x)}>{x}<span class="sr-only"> ({dietLabel(x)})</span></abbr>)}
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}

  <div class="menu-panel" role="tabpanel" id="panel-dietary" aria-labelledby="tab-dietary" tabindex="0" hidden>
    <h2 class="sr-only">Dietary information</h2>
    <p class="menu-panel__note">{s.menuNote}</p>
    <ul class="diet-key">
      {s.dietKey.map((k) => <li><abbr class="diet">{k.code}</abbr> {k.label}</li>)}
    </ul>
    <div class="table-wrap">
      <table class="allergens">
        <caption class="sr-only">Allergens in each item</caption>
        <thead><tr><th scope="col">Item</th><th scope="col">Dietary</th><th scope="col">Contains</th></tr></thead>
        <tbody>
          {s.menu.flatMap((c) => c.items).map((d) => (
            <tr>
              <th scope="row">{d.name}</th>
              <td>{d.diet?.map(dietLabel).join(', ') || '—'}</td>
              <td>{d.allergens?.join(', ') || 'None of the 14 major allergens'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>
