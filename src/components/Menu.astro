---
/**
 * Cardápio em uma página só: as categorias ficam empilhadas, com botões fixos no topo que
 * levam a cada uma (o da categoria visível fica aceso). Cada prato é um cartão escuro com a
 * foto redonda, etiquetas (mais pedida, vegetariana...), preço com o tamanho e um botão "+"
 * que adiciona ao pedido do WhatsApp (src/scripts/cart.ts).
 */
import { site as s, type Diet } from '../data/site';
import { price } from '../lib/format';
import Photo from './Photo.astro';
import Icon from './Icon.astro';

const dietLabel = (d: Diet) => s.dietKey.find((k) => k.code === d)!.label;
/** Stable id for the order: "Frango com catupiry" → "frango-com-catupiry" */
const slug = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const extraPrice = (v: number) => (v === 0 ? 'sem custo' : `+${price(v)}`);
---
<nav class="menu-nav" aria-label="Categorias do cardápio" data-menu-nav>
  <div class="menu-nav__inner">
    {s.menu.map((c, i) => (
      <a class:list={['menu-nav__pill', { 'is-active': i === 0 }]} href={`#${c.id}`} data-menu-link={c.id}>{c.label}</a>
    ))}
  </div>
</nav>

{s.menu.map((c) => (
  <section class="menu-cat" id={c.id} aria-labelledby={`${c.id}-title`} data-menu-cat>
    <header class="menu-cat__head">
      {c.kicker && <p class="menu-cat__kicker">{c.kicker}</p>}
      <h2 class="menu-cat__title" id={`${c.id}-title`}>{c.label}</h2>
      {c.note && <p class="menu-cat__note">{c.note}</p>}
    </header>

    <ul class="dish-grid">
      {c.items.map((d) => (
        <li class="dish">
          <div class="dish__photo">
            {d.photo && <Photo photo={d.photo} ratio={1} widths={[360, 540, 720]} sizes="(min-width: 1400px) 620px, (min-width: 900px) 45vw, 92vw" reveal={false} />}
          </div>
          <div class="dish__body">
            <h3 class="dish__name">{d.name}</h3>
            {(d.signature || d.diet) && (
              <ul class="dish__tags">
                {d.signature && <li class="dish__tag dish__tag--gold"><span aria-hidden="true">★</span> Mais pedida</li>}
                {d.diet?.map((x) => <li class="dish__tag dish__tag--diet">{dietLabel(x)}</li>)}
              </ul>
            )}
            <p class="dish__desc">{d.description}</p>
            <div class="dish__foot">
              <p class="dish__price">
                {c.size && <span class="dish__size">{c.size}</span>}
                <strong>{price(d.price)}</strong>
              </p>
              <div class="qty qty--sm" data-cart-item={slug(d.name)} data-name={d.name} data-price={d.price}>
                <button class="qty__add qty__add--round" type="button" data-cart-add aria-label={`Adicionar ${d.name} ao pedido`}><Icon name="plus" /></button>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>

    {c.extras && (
      <div class="extras">
        <p class="label">Monte do seu jeito</p>
        <ul>
          {c.extras.map((e) => (
            <li>
              <span>{e.name}</span><span class="extras__price">{extraPrice(e.price)}</span>
              {e.price > 0 && (
                <span class="qty qty--sm" data-cart-item={slug(e.name)} data-name={e.name} data-price={e.price}>
                  <button class="qty__add" type="button" data-cart-add aria-label={`Adicionar ${e.name} ao pedido`}><Icon name="plus" class="btn__arrow" /></button>
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}

    {c.id === 'pizzas' && (
      <ul class="callouts">
        {s.menuCallouts.map((m) => (
          <li class="callout">
            <Icon name="info" class="callout__icon" />
            <div>
              <h3 class="callout__title">{m.title}</h3>
              <p>{m.text}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
))}
