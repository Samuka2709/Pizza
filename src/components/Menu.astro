---
import { site as s, type Diet, type MenuItem } from '../data/site';
import { price } from '../lib/format';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { swatch } from '../lib/swatch';

const dietLabel = (d: Diet) => s.dietKey.find((k) => k.code === d)!.label;
/** Diet values used by the filter: vegan counts as vegetarian too */
const dietTags = (d: MenuItem) => {
  const t = new Set(d.diet ?? []);
  if (t.has('VG')) t.add('V');
  return [...t].join(' ');
};
/** Stable id for the order: "Frango com catupiry" → "frango-com-catupiry" */
const slug = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const extraPrice = (v: number) => (v === 0 ? 'sem custo' : `+${price(v)}`);
---
<div class="tabs" data-tabs>
  <div class="tabs__scroller">
    <div class="tabs__list" role="tablist" aria-label="Seções do cardápio">
      {s.menu.map((c, i) => (
        <button class="tab" type="button" role="tab" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          {c.label}
        </button>
      ))}
      <span class="tabs__indicator" aria-hidden="true"></span>
    </div>
  </div>
</div>

<div class="menu-panels">
  {s.menu.map((c, i) => (
    <div class="menu-panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} tabindex="0" hidden={i !== 0}>
      <h2 class="sr-only">{c.label}</h2>

      {c.intro && (
        <div class="menu-intro">
          <div>
            <p class="menu-intro__title">{c.intro.title}</p>
            <p class="menu-intro__text">{c.intro.text}</p>
          </div>
          <ul class="menu-intro__facts">
            {c.intro.facts.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      )}

      {c.items.some((d) => d.photo) ? (
        <>
          <div class="menu-tools">
            <p class="menu-panel__note">{c.note}</p>
            {c.id === 'pizzas' && <div class="chips" role="group" aria-label="Filtrar pizzas" data-filter>
              <button class="chip" type="button" aria-pressed="true" data-filter-value="">Todas</button>
              <button class="chip" type="button" aria-pressed="false" data-filter-value="V">Vegetarianas</button>
              <button class="chip" type="button" aria-pressed="false" data-filter-value="VG">Veganas</button>
            </div>}
          </div>
          <p class="sr-only" aria-live="polite" data-filter-status></p>
          <ul class="pizza-grid">
            {c.items.map((d, k) => (
              <li class="pizza-card" data-diet={dietTags(d)} style={`--i:${k};--bg:${swatch(k).bg};--fg:${swatch(k).fg};--line:${swatch(k).line};--tilt:${[-1.2, 0.8, -0.6, 1.1][k % 4]}deg`}>
                <div class="pizza-card__media">
                  {d.photo && <Photo photo={d.photo} ratio={1} widths={[240, 360, 540, 720]} sizes="(min-width: 1100px) 30vw, (min-width: 640px) 46vw, 120px" reveal={false} />}
                  {d.signature && <span class="pizza-card__badge">Mais pedida</span>}
                </div>
                <div class="pizza-card__body">
                  <div class="pizza-card__top">
                    <h3 class="pizza-card__name">{d.name}</h3>
                  </div>
                  <p class="pizza-card__desc">{d.description}</p>
                  <div class="pizza-card__foot">
                    <p class="pizza-card__diet">{d.diet ? d.diet.map(dietLabel).join(' · ') : ''}</p>
                    <p class="pill">{price(d.price)}</p>
                  </div>
                  <div class="qty" data-cart-item={slug(d.name)} data-name={d.name} data-price={d.price}>
                    <button class="qty__add" type="button" data-cart-add aria-label={`Adicionar ${d.name} ao pedido`}><Icon name="plus" class="btn__arrow" /> Adicionar<span class="qty__more"> ao pedido</span></button>
                  </div>
                </div>
              </li>
            ))}
          </ul>

          {c.extras && (
            <div class="extras">
              <p class="label">Monte do seu jeito</p>
              <ul>
                {c.extras.map((e) => (
                  <li>
                    <span>{e.name}</span><span class="extras__price">{extraPrice(e.price)}</span>
                    {e.price > 0 && (
                      <span class="qty qty--sm" data-cart-item={slug(e.name)} data-name={e.name} data-price={e.price}>
                        <button class="qty__add" type="button" data-cart-add aria-label={`Adicionar ${e.name} ao pedido`}><Icon name="plus" class="btn__arrow" /></button>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {c.id === 'pizzas' && <ul class="callouts">
            {s.menuCallouts.map((m) => (
              <li class="callout">
                <Icon name="info" class="callout__icon" />
                <div>
                  <h3 class="callout__title">{m.title}</h3>
                  <p>{m.text}</p>
                </div>
              </li>
            ))}
          </ul>}
        </>
      ) : (
        <>
          {c.note && <p class="menu-panel__note">{c.note}</p>}
          <ul class="menu-list">
            {c.items.map((d) => (
              <li class:list={['menu-row', { 'menu-row--signature': d.signature }]}>
                <div class="menu-row__top">
                  <h3 class="menu-row__name">{d.name}</h3>
                  {d.signature && <span class="tag">Mais pedida</span>}
                  <span class="menu-row__leader" aria-hidden="true"></span>
                  <p class="price">{price(d.price)}</p>
                </div>
                <div class="menu-row__bottom">
                  <p class="menu-row__desc">{d.description}</p>
                  <span class="qty qty--sm" data-cart-item={slug(d.name)} data-name={d.name} data-price={d.price}>
                    <button class="qty__add" type="button" data-cart-add aria-label={`Adicionar ${d.name} ao pedido`}><Icon name="plus" class="btn__arrow" /></button>
                  </span>
                </div>
                {d.diet && (
                  <p class="menu-row__diet">
                    {d.diet.map((x) => <abbr class="diet" title={dietLabel(x)}>{x}<span class="sr-only"> ({dietLabel(x)})</span></abbr>)}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  ))}
</div>
