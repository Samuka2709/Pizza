---
import { site as s } from '../data/site';
import { price } from '../lib/format';
import Photo from './Photo.astro';
import Icon from './Icon.astro';

// House favourites first, then the rest of the pizzas with a photo
const pizzas = s.menu[0].items.filter((i) => i.photo).sort((a, b) => Number(!!b.signature) - Number(!!a.signature));
const dietWord = { V: 'Vegetariana', VG: 'Vegana', GF: 'Sem glúten', N: 'Contém castanhas' } as const;
---
<!-- A deck of pizza cards: the front one flies to the back on Next / drag / arrow keys -->
<div class="deck" data-deck>
  <ul class="deck__stack" aria-roledescription="carousel" aria-label="Nossas pizzas">
    {pizzas.map((d, i) => {
      return (
        <li class="deck__card" data-deck-card aria-roledescription="slide" aria-label={`${i + 1} de ${pizzas.length}: ${d.name}`}>
          <div class="deck__media">
            <Photo photo={d.photo!} ratio={1} widths={[320, 480, 640]} sizes="(min-width: 900px) 320px, 70vw" reveal={false} />
          </div>
          <div class="deck__body">
            <h3 class="deck__name">{d.name}</h3>
            {(d.signature || d.diet) && (
              <ul class="dish__tags">
                {d.signature && <li class="dish__tag dish__tag--gold"><span aria-hidden="true">★</span> Mais pedida</li>}
                {d.diet?.map((x) => <li class="dish__tag dish__tag--diet">{dietWord[x]}</li>)}
              </ul>
            )}
            <p class="deck__desc">{d.description}</p>
            <div class="deck__foot">
              <p class="dish__price">
                {s.menu[0].size && <span class="dish__size">{s.menu[0].size}</span>}
                <strong>{price(d.price)}</strong>
              </p>
            </div>
          </div>
        </li>
      );
    })}
  </ul>
  <div class="deck__controls">
    <button class="icon-round" type="button" data-deck-prev><Icon name="prev" /><span class="sr-only">Pizza anterior</span></button>
    <p class="deck__count" aria-live="polite" data-deck-count>1 / {pizzas.length}</p>
    <button class="icon-round icon-round--solid" type="button" data-deck-next><Icon name="next" /><span class="sr-only">Próxima pizza</span></button>
  </div>
</div>
