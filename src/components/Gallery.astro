---
import { site as s } from '../data/site';
import Photo from './Photo.astro';
const ratioFor = (span: string) => (span === 'tall' ? 0.75 : span === 'wide' ? 1.6 : 1);
---
<ul class="gallery">
  {s.gallery.map((p) => (
    <li class:list={['gallery__cell', p.span && `gallery__cell--${p.span}`]}>
      <Photo photo={p} ratio={ratioFor(p.span)} widths={p.span === 'wide' ? [640, 960, 1400] : [360, 540, 800]} sizes={p.span === 'wide' ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'} />
    </li>
  ))}
</ul>
