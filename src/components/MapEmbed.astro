---
/**
 * Google Maps embed, shown right away. The iframe is lazy: it only loads when it comes near
 * the screen, so it does not slow down the top of the page. A link opens the full Google Maps.
 */
import Icon from './Icon.astro';
interface Props {
  src: string;
  title: string;
  link: string;
}
const { src, title, link } = Astro.props;
---
<figure class="map">
  <iframe src={src} title={title} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
  <a class="map__open btn btn--sm btn--light" href={link} target="_blank" rel="noopener"><Icon name="pin" class="btn__arrow" /> Abrir no Google Maps</a>
</figure>
