---
import Icon from './Icon.astro';
interface Props {
  src: string;
  title: string;
  link: string;
}
const { src, title, link } = Astro.props;
---
<!-- Map loads only on request: no Google cookies or weight until the visitor asks for it -->
<div class="map" data-map={src} data-map-title={title}>
  <div class="map__placeholder">
    <Icon name="pin" class="map__pin" />
    <p>{title}</p>
    <div class="map__actions">
      <button class="btn btn--sm btn--primary" type="button" data-map-load>Show map</button>
      <a class="btn btn--sm btn--outline" href={link} target="_blank" rel="noopener">Open in Google Maps</a>
    </div>
    <p class="map__note">Showing the map loads content from Google.</p>
  </div>
</div>
