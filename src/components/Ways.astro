---
import { site as s } from '../data/site';
import { whatsappLink } from '../lib/format';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
---
<ul class="events">
  {s.ways.items.map((w, i) => {
    const wa = w.action === 'whatsapp';
    const href = wa ? whatsappLink(`Olá! Quero fazer um pedido (${w.name.toLowerCase()}).`) : w.action;
    return (
      <li class="event" data-reveal="fade">
        <a class="event__link" href={href} target={wa ? '_blank' : undefined} rel={wa ? 'noopener' : undefined} data-cursor={wa ? 'Pedir' : 'Ver'}>
          <div class="event__media">
            <Photo photo={w.photo} ratio={4 / 5} widths={[360, 540, 720]} sizes="(min-width: 1024px) 20vw, (min-width: 640px) 45vw, 80vw" reveal={false} />
          </div>
          <span class="event__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="event__name">{w.name}</h3>
          <p class="event__text">{w.text}</p>
          <span class="event__cta">{wa && <Icon name="whatsapp" class="btn__arrow" />}{w.cta} {!wa && <Icon name="arrow" class="btn__arrow" />}</span>
        </a>
      </li>
    );
  })}
</ul>
