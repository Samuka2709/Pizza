---
import { site as s } from '../data/site';
import Icon from './Icon.astro';
const types = s.events.types;
---
<form class="form" id="quote-form" novalidate data-quote-form>
  <div class="field">
    <label for="q-name">Seu nome <span class="req" aria-hidden="true">*</span></label>
    <input class="input" id="q-name" name="name" type="text" autocomplete="name" required aria-describedby="q-name-err" />
    <p class="field__error" id="q-name-err"></p>
  </div>

  <div class="field field--half">
    <label for="q-email">E-mail <span class="req" aria-hidden="true">*</span></label>
    <input class="input" id="q-email" name="email" type="email" autocomplete="email" required aria-describedby="q-email-err" />
    <p class="field__error" id="q-email-err"></p>
  </div>

  <div class="field field--half">
    <label for="q-phone">Telefone ou WhatsApp <span class="req" aria-hidden="true">*</span></label>
    <input class="input" id="q-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="(73) 90000-0000" required aria-describedby="q-phone-err" />
    <p class="field__error" id="q-phone-err"></p>
  </div>

  <div class="field field--half">
    <label for="q-date">Data da festa <span class="req" aria-hidden="true">*</span></label>
    <input class="input" id="q-date" name="event_date" type="date" required aria-describedby="q-date-err" />
    <p class="field__error" id="q-date-err"></p>
  </div>

  <div class="field field--half">
    <label for="q-guests">Número de convidados <span class="req" aria-hidden="true">*</span></label>
    <input class="input" id="q-guests" name="guests" type="number" inputmode="numeric" min="10" max="5000" step="1" placeholder="ex.: 40" required aria-describedby="q-guests-err" />
    <p class="field__error" id="q-guests-err"></p>
  </div>

  <div class="field field--half">
    <label for="q-type">Tipo de evento <span class="req" aria-hidden="true">*</span></label>
    <select class="input" id="q-type" name="event_type" required aria-describedby="q-type-err">
      <option value="">Escolha uma opção</option>
      {types.map((t) => <option value={t.id}>{t.name}</option>)}
      <option value="outro">Outro</option>
    </select>
    <p class="field__error" id="q-type-err"></p>
  </div>

  <div class="field field--half">
    <label for="q-location">Local da festa <span class="req" aria-hidden="true">*</span></label>
    <input class="input" id="q-location" name="location" type="text" autocomplete="postal-code" placeholder="Bairro, cidade ou CEP" required aria-describedby="q-location-err" />
    <p class="field__error" id="q-location-err"></p>
  </div>

  <div class="field">
    <label for="q-message">Conte mais sobre a festa</label>
    <textarea class="input" id="q-message" name="message" rows="4" placeholder="Horário, sabores preferidos, restrições alimentares"></textarea>
  </div>

  <!-- Spam protection: a hidden field people never fill in, plus a minimum time on the page -->
  <div class="hp" aria-hidden="true">
    <label for="q-website">Deixe este campo vazio</label>
    <input id="q-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field field--check">
    <input id="q-consent" name="consent" type="checkbox" required aria-describedby="q-consent-err" />
    <label for="q-consent">Concordo que a {s.name} use estes dados para responder ao meu pedido, conforme o <a class="link-line" href="/privacidade/">aviso de privacidade</a>. <span class="req" aria-hidden="true">*</span></label>
    <p class="field__error" id="q-consent-err"></p>
  </div>

  <div class="form__submit">
    <p class="sr-only" role="status" aria-live="polite" data-form-status></p>
    <button class="btn btn--primary btn--block" type="submit" data-magnetic>
      <span data-submit-label>Enviar pedido de orçamento</span> <Icon name="arrow" class="btn__arrow" />
    </button>
    <p class="form__fineprint">Respondemos em até um dia útil. Nenhum pagamento é feito pelo site.</p>
  </div>
</form>

<div class="form-success" data-form-success hidden tabindex="-1">
  <span class="form-success__icon" aria-hidden="true"><Icon name="check" /></span>
  <h3 class="display h3">{s.quoteForm.successTitle}</h3>
  <p>{s.quoteForm.successText}</p>
  {!s.quoteForm.endpoint && <p class="form-success__demo">Site modelo: aqui nada é enviado. No site real, o pedido chega no e-mail ou no WhatsApp da pizzaria.</p>}
</div>
