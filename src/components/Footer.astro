---
import { site as s } from '../data/site';
import { mailto, popupTimes, socialLinks, DAYS } from '../lib/format';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="crust crust--top" aria-hidden="true"></div>
  <div class="container">
    <div class="footer__cta">
      <p class="display footer__cta-title">Planning something? <em>Let's talk pizza.</em></p>
      <a class="btn btn--light" href="/contact/#quote" data-magnetic>Get an event quote <Icon name="arrow" class="btn__arrow" /></a>
    </div>

    <div class="footer__cols">
      <div class="footer__col">
        <h2 class="label">{s.name}</h2>
        <p class="footer__tagline">{s.tagline}</p>
      </div>
      <nav class="footer__col" aria-label="Footer">
        <h2 class="label">Explore</h2>
        <ul>
          {s.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="footer__col">
        <h2 class="label">Contact</h2>
        <ul>
          <li><a href={`tel:${s.contact.phoneHref}`}>{s.contact.phone}</a></li>
          <li><a href={mailto("Enquiry from the website")}>{s.contact.email}</a></li>
          {socialLinks().map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>)}
        </ul>
      </div>
      <div class="footer__col">
        <h2 class="label">Friday pop-up</h2>
        <p>{DAYS[s.popup.weekday]}s, {popupTimes()}<br />{s.popup.place}</p>
        <a class="link-line" href="/pop-up/">How to find us</a>
      </div>
    </div>

    <p class="footer__name" aria-hidden="true">{s.name}</p>

    <div class="footer__bottom">
      <span>© {year} {s.footer.copyright}. All rights reserved.</span>
      <a href="/privacy/" class="link-line">Privacy &amp; cookies</a>
    </div>
  </div>
</footer>
