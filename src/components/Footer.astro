---
import { site as s } from '../data/site';
import { mailto, popupTimes, socialLinks, DAYS, whatsappLink } from '../lib/format';
import Icon from './Icon.astro';
import Hours from './Hours.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="crust crust--top" aria-hidden="true"></div>
  <div class="container">
    <div class="footer__cta">
      <p class="display footer__cta-title">Bateu a fome? <em>A gente entrega.</em></p>
      <a class="btn btn--light" href={whatsappLink()} target="_blank" rel="noopener" data-magnetic><Icon name="whatsapp" class="btn__arrow" /> Pedir pelo WhatsApp</a>
    </div>

    <div class="footer__cols">
      <div class="footer__col">
        <h2 class="label">{s.name}</h2>
        <p class="footer__tagline">{s.tagline}</p>
      </div>
      <nav class="footer__col" aria-label="Rodapé">
        <h2 class="label">Navegue</h2>
        <ul>
          {s.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="footer__col">
        <h2 class="label">Contato</h2>
        <ul>
          <li><a href={`tel:${s.contact.phoneHref}`}>{s.contact.phone}</a></li>
          <li><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href={mailto("Contato pelo site")}>{s.contact.email}</a></li>
          {socialLinks().map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>)}
        </ul>
      </div>
      <div class="footer__col">
        <h2 class="label">Horário</h2>
        <Hours compact />
        <p class="footer__popup">Rodízio toda {DAYS[s.popup.weekday]}, {popupTimes()}.<br />{s.popup.place}</p>
        <a class="link-line" href="/rodizio/">Como chegar</a>
      </div>
    </div>

    <p class="footer__name" aria-hidden="true">{s.name}</p>

    <div class="footer__bottom">
      <span>Site modelo ({year}): cardápio, preços e contatos de exemplo.</span>
      <a href="/privacidade/" class="link-line">Privacidade e cookies</a>
    </div>
  </div>
</footer>
