---
import { site as s } from '../data/site';
import { DAYS, popupTimes } from '../lib/format';
import Icon from './Icon.astro';
const words = (t: string) => t.split(' ');
---
<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="hero__stage">
    <!-- Brand video: the sliced pizza turning with steam. Two copies cross-fade so the loop has no visible jump (src/scripts/pizza.ts) -->
    <div class="hero__media" aria-hidden="true">
      <!-- First frame as a real image: shows at once, the right size per screen, and is what stays with reduced motion -->
      <picture>
        <source media="(min-width: 900px)" srcset="/video/hero-poster.webp" width="1280" height="720" />
        <img class="hero__video hero__poster" src="/video/hero-poster-sm.webp" width="854" height="480" alt="" fetchpriority="high" decoding="async" />
      </picture>
      {[0, 1].map((i) => (
        <video class:list={['hero__video', { 'is-front': i === 0 }]} muted playsinline preload={i === 0 ? 'metadata' : 'none'} disablepictureinpicture data-hero-video>
          <source src="/video/hero-854.mp4" type="video/mp4" media="(max-width: 899px)" />
          <source src="/video/hero-1280.webm" type="video/webm" />
          <source src="/video/hero-1280.mp4" type="video/mp4" />
        </video>
      ))}
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <!-- Moving content longer than 5 s needs a way to stop it (WCAG 2.2.2) -->
    <button class="hero__pause" type="button" aria-pressed="false" data-hero-pause hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" data-icon-pause><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
      <svg viewBox="0 0 24 24" aria-hidden="true" data-icon-play hidden><path d="M8 5.5v13l11-6.5z" /></svg>
      <span class="sr-only" data-pause-label>Pause the video</span>
    </button>

    <div class="container hero__content">
      <p class="label hero__eyebrow">{s.hero.eyebrow}</p>
      <h1 class="hero__title" id="hero-title" data-split>
        {words(s.name).map((w, i) => <>{i > 0 && ' '}<span class="mask"><span>{w}</span></span></>)}
      </h1>
      <p class="hero__tagline" data-split>
        {words(s.tagline).map((w, i) => <>{i > 0 && ' '}<span class="mask"><span>{w}</span></span></>)}
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/contact/#quote" data-magnetic>Get an event quote <Icon name="arrow" class="btn__arrow" /></a>
        <a class="btn btn--outline" href="/pop-up/">{DAYS[s.popup.weekday]}s in Stanmore</a>
      </div>
      <p class="hero__info">
        <Icon name="clock" class="hero__info-icon" />
        <span data-next-popup>Pop-up every {DAYS[s.popup.weekday]}, {popupTimes()}</span>
      </p>
    </div>

    <div class="hero__scroll" aria-hidden="true">
      Scroll <span class="hero__scroll-line"></span>
    </div>
  </div>
</section>
