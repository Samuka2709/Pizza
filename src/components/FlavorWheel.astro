---
/**
 * "Gire a pizza": a seção fica presa na tela; a cada trecho de rolagem a pizza inteira gira e
 * dá lugar ao próximo sabor. Os nomes dos sabores ficam num arco em volta, com uma bolinha no atual.
 * Modelo: slider giratório do Figma (vídeo de referência), adaptado às cores e fontes do site.
 */
import { flavors } from '../data/flavors';
import { price, whatsappLink } from '../lib/format';
import Icon from './Icon.astro';
import SectionLabel from './SectionLabel.astro';

interface Props {
  num?: string;
}
const { num } = Astro.props;
const first = flavors[0];
const light = ['#f6f1e4', '#efe3c4', '#f3efe6'];
const srcset = (img: string) => `/img/sabores/${img}-sm.webp 560w, /img/sabores/${img}-720.webp 720w, /img/sabores/${img}.webp 900w`;
const data = flavors.map((f) => ({ name: f.name, price: f.price, priceLabel: price(f.price), desc: f.desc, ing: f.ing, order: whatsappLink(`Olá! Quero pedir uma pizza de ${f.name}.`) }));
---
<section class="wheel" aria-labelledby="wheel-title" data-wheel style={`--n:${flavors.length}`}>
  <div class="wheel__stage">
    <div class="container wheel__head">
      <SectionLabel num={num} text="Gire a pizza" />
      <h2 class="sr-only" id="wheel-title">Sabores da casa</h2>
      <div class="wheel__swap" data-wheel-info aria-live="polite">
        <div class="wheel__title">
          <p class="wheel__name" data-wheel-name>{first.name}</p>
          <p class="wheel__price" data-wheel-price>{price(first.price)}</p>
        </div>
        <div class="wheel__desc" data-wheel-desc><p>{first.desc[0]}</p></div>
        <ul class="wheel__ing" data-wheel-ing>
          {first.ing.map(([n, c]) => <li><i style={`background:${c}${light.includes(c) ? ';box-shadow:inset 0 0 0 1px #d9cfb6' : ''}`}></i>{n}</li>)}
        </ul>
      </div>
      <a class="btn btn--primary wheel__order" href={data[0].order} target="_blank" rel="noopener" data-wheel-order data-magnetic>
        <Icon name="whatsapp" class="btn__arrow" /> Pedir pelo WhatsApp
      </a>
    </div>

    <!-- Dial: half a pizza rising from the bottom, flavour names on an arc around it -->
    <div class="wheel__dial" data-wheel-dial>
      <svg class="wheel__tracks" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="40.5" />
        <circle cx="50" cy="50" r="43.5" />
      </svg>
      <span class="wheel__dot" aria-hidden="true"></span>
      <ul class="wheel__names" data-wheel-names>
        {flavors.map((f, i) => (
          <li style={`--i:${i}`}>
            <button type="button" class:list={{ 'is-active': i === 0 }} aria-pressed={i === 0 ? 'true' : 'false'} data-wheel-go={i}>{f.name}</button>
          </li>
        ))}
      </ul>
      <div class="wheel__pizzas">
        {flavors.map((f, i) => (
          <img
            class:list={['wheel__pizza', { 'is-active': i === 0, 'is-next': i > 0 }]}
            {...(i === 0
              ? { src: `/img/sabores/${f.img}-sm.webp`, srcset: srcset(f.img) }
              : { 'data-src': `/img/sabores/${f.img}-sm.webp`, 'data-srcset': srcset(f.img) })}
            sizes="(min-width: 900px) min(46vw, 64vh), min(86vw, 46vh)"
            width="900"
            height="900"
            alt={i === 0 ? `Pizza de ${f.name} vista de cima` : ''}
            loading="lazy"
            decoding="async"
            data-wheel-pizza
          />
        ))}
      </div>
    </div>

    <button class="icon-round wheel__arrow wheel__arrow--prev" type="button" data-wheel-prev><Icon name="prev" /><span class="sr-only">Sabor anterior</span></button>
    <button class="icon-round wheel__arrow wheel__arrow--next" type="button" data-wheel-next><Icon name="next" /><span class="sr-only">Próximo sabor</span></button>
  </div>
  <script type="application/json" data-wheel-data set:html={JSON.stringify(data)} />
</section>
