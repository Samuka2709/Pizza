---
import type { Photo as PhotoT } from '../data/site';
import { photoUrl, photoSrcset } from '../lib/img';

interface Props {
  photo: PhotoT;
  /** width / height */
  ratio: number;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
  reveal?: 'clip' | 'fade' | false;
}
const { photo, ratio, widths = [400, 640, 900, 1200], sizes = '100vw', priority = false, class: cls = '', reveal = 'clip' } = Astro.props;
const base = widths[Math.min(1, widths.length - 1)];
---
{photo.id ? (
  <div class:list={['ph', cls]} style={`aspect-ratio:${ratio}`} data-reveal={reveal || undefined}>
    <img
      src={photoUrl(photo.id, base, ratio)}
      srcset={photoSrcset(photo.id, ratio, widths)}
      sizes={sizes}
      width={base}
      height={Math.round(base / ratio)}
      alt={photo.alt}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
    />
  </div>
) : (
  <div class:list={['ph ph--empty', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Photo to come: ${photo.alt}`} data-reveal={reveal || undefined}>
    <span class="ph__caption" aria-hidden="true"><span class="ph__tag">Photo</span>{photo.alt}</span>
  </div>
)}
