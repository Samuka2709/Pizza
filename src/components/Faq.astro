---
import { site as s } from '../data/site';
---
<div class="faq">
  {s.events.faq.map((f) => (
    <details class="faq__item" data-reveal="fade">
      <summary class="faq__q">
        <span>{f.q}</span>
        <span class="faq__icon" aria-hidden="true"></span>
      </summary>
      <div class="faq__a"><p>{f.a}</p></div>
    </details>
  ))}
</div>
