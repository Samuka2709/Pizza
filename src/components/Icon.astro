---
export type IconName =
  | 'arrow' | 'close' | 'prev' | 'next' | 'info' | 'instagram' | 'facebook' | 'tiktok'
  | 'phone' | 'whatsapp' | 'mail' | 'pin' | 'clock' | 'plus' | 'check' | 'play' | 'slice' | 'train';
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'prev' && <path d="M20 12H5M11 6l-6 6 6 6" />}
  {name === 'next' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {name === 'close' && <path d="M5 5l14 14M19 5L5 19" />}
  {name === 'info' && <><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></>}
  {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />}
  {name === 'whatsapp' && <path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.4-4.3A8.5 8.5 0 1 1 20.5 11.7zM9 8.2c.2-.4.5-.4.8-.4h.6c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .6l-.5.7c-.1.2-.2.3 0 .6.4.7 1 1.4 1.7 1.9.6.4 1 .6 1.3.7.2.1.4 0 .5-.1l.7-.9c.2-.2.4-.2.6-.1l1.8.9c.2.1.4.2.4.4 0 .3 0 1.2-.6 1.7-.5.5-1.4.8-2.3.6a8.7 8.7 0 0 1-5.6-4.8c-.6-1.2-.7-2.4-.3-3.3z" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></>}
  {name === 'pin' && <><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'play' && <path d="M8 5.5v13l11-6.5-11-6.5z" />}
  {name === 'train' && <><rect x="6" y="3" width="12" height="13" rx="3" /><path d="M6 10h12M9 20l-1.5 1.5M15 20l1.5 1.5M9 13h.01M15 13h.01" /></>}
  {name === 'slice' && <><path d="M12 21L3.5 5.5a17 17 0 0 1 17 0L12 21z" /><path d="M4.6 7.4a15 15 0 0 1 14.8 0" /><circle cx="10" cy="10" r="1.2" /><circle cx="14" cy="12.5" r="1.2" /><circle cx="12" cy="16" r="1" /></>}
  {name === 'instagram' && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><path d="M17.2 6.8h.01" /></>}
  {name === 'facebook' && <path d="M14 8.5h2.5V5H14a3.5 3.5 0 0 0-3.5 3.5V11H8v3.5h2.5V21H14v-6.5h2.5L17 11h-3V9a.5.5 0 0 1 .5-.5z" />}
  {name === 'tiktok' && <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.1 4.3 5 4.5" />}
</svg>
