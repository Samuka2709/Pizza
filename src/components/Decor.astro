---
/**
 * Decorative outline circles that drift at different speeds while scrolling.
 * Purely decorative: hidden from assistive tech, no pointer events.
 */
interface Item {
  /** position in % of the section */
  x: number;
  y: number;
  /** diameter in px (desktop) */
  size: number;
  /** scroll speed: negative moves up, positive down */
  speed: number;
  mobile?: boolean;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
<div class="decor" aria-hidden="true" data-decor>
  {items.map((it) => (
    <span
      class:list={['decor__item decor__item--ring', { 'decor__item--desktop': !it.mobile }]}
      style={`left:${it.x}%;top:${it.y}%;--size:${it.size}px`}
      data-speed={it.speed}
    ></span>
  ))}
</div>
