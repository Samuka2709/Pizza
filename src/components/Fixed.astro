---
import { site as s } from '../data/site';
import Icon from './Icon.astro';
---
<div class="mobile-bar" data-mobile-bar role="region" aria-label="Quick actions">
  <a class="btn btn--outline" href={`tel:${s.contact.phoneHref}`}><Icon name="phone" class="btn__arrow" /> Call</a>
  <a class="btn btn--primary" href="/contact/#quote">Get a quote <Icon name="arrow" class="btn__arrow" /></a>
</div>

<div class="cookie" role="region" aria-label="Cookie notice" data-cookie hidden>
  <p>Essential cookies only. Maps load when you ask. <a class="link-line" href="/privacy/">Privacy</a></p>
  <button class="btn btn--sm btn--primary" type="button" data-cookie-ok>OK</button>
</div>

<div class="cursor" aria-hidden="true" data-cursor-el><span data-cursor-label></span></div>
