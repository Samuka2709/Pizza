---
import SectionLabel from './SectionLabel.astro';
interface Props {
  label: string;
  title: string;
  lead?: string;
}
const { label, title, lead } = Astro.props;
---
<section class="page-hero" aria-labelledby="page-title">
  <div class="container">
    <SectionLabel text={label} />
    <h1 class="display page-hero__title reveal-words" id="page-title" data-split-auto>{title}</h1>
    {lead && <p class="lead page-hero__lead" data-reveal="fade">{lead}</p>}
    <slot />
  </div>
  <div class="page-hero__pizza" aria-hidden="true" data-spin></div>
</section>
