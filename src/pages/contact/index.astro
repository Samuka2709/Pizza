---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Icon from '../../components/Icon.astro';
import { site as s } from '../../data/site';
import { mailto, socialLinks, DAYS, popupTimes } from '../../lib/format';
---
<Base title="Contact & Book an Event" path="/contact/" description={`Ask ${s.name} for a quote for your wedding, party, corporate event, school or festival. Call, email or send the enquiry form.`}>
  <PageHero label="Contact / book an event" title="Tell us about your event." lead="Share a few details and we will reply within one working day with availability and a fixed quote." />

  <section class="section section--tight" id="quote" aria-labelledby="quote-title">
    <div class="container contact__grid">
      <div class="contact__form" data-reveal="fade">
        <h2 class="display h3" id="quote-title">Event enquiry</h2>
        <QuoteForm />
      </div>

      <aside class="contact__side" aria-label="Other ways to reach us">
        <div class="contact__card" data-reveal="fade">
          <h2 class="label">Prefer to talk?</h2>
          <a class="contact__big" href={`tel:${s.contact.phoneHref}`}><Icon name="phone" /> {s.contact.phone}</a>
          <a class="contact__big" href={mailto('Event enquiry')}><Icon name="mail" /> {s.contact.email}</a>
        </div>
        <div class="contact__card" data-reveal="fade">
          <h2 class="label">Follow along</h2>
          <ul class="contact__social">
            {socialLinks().map((l) => <li><a class="link-line" href={l.url} target="_blank" rel="noopener"><Icon name={l.key as 'instagram' | 'facebook' | 'tiktok'} class="btn__arrow" /> {l.label}</a></li>)}
          </ul>
        </div>
        <div class="contact__card" data-reveal="fade">
          <h2 class="label">Friday pop-up</h2>
          <p>Every {DAYS[s.popup.weekday]}, {popupTimes()}<br />{s.popup.place}</p>
          <a class="link-line" href="/pop-up/">Map and directions <Icon name="arrow" class="btn__arrow" /></a>
        </div>
        <div class="contact__card" data-reveal="fade">
          <h2 class="label">Where we cater</h2>
          <p>{s.contact.serviceArea}</p>
        </div>
      </aside>
    </div>
  </section>
</Base>
