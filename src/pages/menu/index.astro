---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Menu from '../../components/Menu.astro';
import Icon from '../../components/Icon.astro';
import Decor from '../../components/Decor.astro';
import { site as s } from '../../data/site';
---
<Base title="Menu" path="/menu/" description={`The ${s.name} menu: Neapolitan-style pizzas, desserts and full dietary and allergen information.`}>
  <PageHero label="Menu" title="Pizzas, a few sweet things, nothing complicated." lead="The same menu we cook at events and at our Friday pop-up. Event menus can be tailored to your guests." />
  <section class="section section--tight menu-section" aria-label="Menu">
    <Decor items={[
      { src: 'basil', x: -3, y: 18, size: 140, rot: 30, speed: -0.5, spin: 50 },
      { src: 'pepperoni-0', x: 95, y: 24, size: 80, speed: 0.6, spin: 160 },
      { src: 'mozzarella', x: -2, y: 52, size: 90, speed: 0.4, spin: -40 },
      { src: 'basil', x: 94, y: 62, size: 120, rot: -120, speed: -0.4, spin: -40 },
      { src: 'pepperoni-1', x: 2, y: 82, size: 66, speed: 0.7, spin: 140 },
      { x: 90, y: 40, size: 110, speed: 0.3 },
      { x: 4, y: 34, size: 40, speed: -0.6 },
      { x: 92, y: 88, size: 60, speed: 0.5 },
    ]} />
    <div class="container">
      <Menu />
      <div class="menu-cta" data-reveal="fade">
        <p>Want this at your event?</p>
        <a class="btn btn--primary" href="/contact/#quote" data-magnetic>Get an event quote <Icon name="arrow" class="btn__arrow" /></a>
      </div>
    </div>
  </section>
</Base>
