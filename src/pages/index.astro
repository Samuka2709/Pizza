---
import Base from '../layouts/Base.astro';
import PizzaHero from '../components/PizzaHero.astro';
import Marquee from '../components/Marquee.astro';
import BrandFilm from '../components/BrandFilm.astro';
import EventTypes from '../components/EventTypes.astro';
import PopupStrip from '../components/PopupStrip.astro';
import Gallery from '../components/Gallery.astro';
import Photo from '../components/Photo.astro';
import PizzaDeck from '../components/PizzaDeck.astro';
import Decor from '../components/Decor.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Icon from '../components/Icon.astro';
import { site as s } from '../data/site';

---
<Base>
  <PizzaHero />
  <Marquee />

  <section class="section intro" aria-labelledby="intro-title">
    <div class="container intro__grid">
      <SectionLabel num="01" text={s.intro.label} />
      <h2 class="display h2 reveal-words intro__title" id="intro-title" data-split-auto>{s.intro.title}</h2>
      <div class="intro__body">
        <p class="lead" data-reveal="fade">{s.intro.text}</p>
        <a class="link-line" href="/our-story/" data-reveal="fade">Our story <Icon name="arrow" class="btn__arrow" /></a>
      </div>
    </div>
  </section>

  <BrandFilm />

  <section class="section section--paper" aria-labelledby="events-title">
    <div class="container">
      <header class="section-head section-head--split">
        <div>
          <SectionLabel num="03" text="Events & catering" />
          <h2 class="display h2 reveal-words" id="events-title" data-split-auto>{s.events.title}</h2>
        </div>
        <div>
          <p class="lead" data-reveal="fade">{s.events.lead}</p>
          <a class="btn btn--primary section-head__cta" href="/contact/#quote" data-reveal="fade" data-magnetic>Get an event quote <Icon name="arrow" class="btn__arrow" /></a>
        </div>
      </header>
      <EventTypes />
    </div>
  </section>

  <PopupStrip num="04" />

  <!-- Scroll-driven on desktop: the section stays pinned while the cards turn over one by one -->
  <section class="section deck-section" aria-labelledby="menu-title" data-deck-scroll>
    <div class="deck-section__pin">
    <Decor items={[
      { src: 'basil', x: 8, y: 34, size: 140, rot: -20, speed: -0.3, spin: 40, mobile: true },
      { src: 'pepperoni-0', x: 86, y: 6, size: 86, speed: 0.5, spin: 120, mobile: true },
      { src: 'mozzarella', x: 92, y: 66, size: 96, rot: 10, speed: -0.4, spin: -30 },
      { src: 'pepperoni-1', x: 93, y: 46, size: 64, speed: 0.5, spin: -140, mobile: true },
      { src: 'basil', x: 4, y: 84, size: 110, rot: 140, speed: -0.3, spin: 30 },
      { x: 84, y: 36, size: 120, speed: 0.4 },
      { x: 38, y: 64, size: 46, speed: -0.7 },
      { x: 78, y: 86, size: 70, speed: 0.3 },
      { x: 12, y: 10, size: 28, speed: 0.9 },
    ]} />
    <div class="container deck-section__grid">
      <div class="deck-section__text">
        <SectionLabel num="05" text="The menu" />
        <h2 class="display h2 reveal-words" id="menu-title" data-split-auto>Short menu, slow dough.</h2>
        <p class="lead" data-reveal="fade">A handful of pizzas we know by heart, with vegetarian and vegan options every time.</p>
        <div class="deck-section__ctas" data-reveal="fade">
          <a class="btn btn--primary" href="/menu/" data-magnetic>See the full menu <Icon name="arrow" class="btn__arrow" /></a>
          <a class="link-line" href="/contact/#quote">Pizza for your event</a>
        </div>
      </div>
      <PizzaDeck />
    </div>
    <div class="deck-section__progress" aria-hidden="true"><span data-deck-progress></span></div>
    </div>
  </section>

  <section class="section section--paper story-teaser" aria-labelledby="story-title">
    <div class="container story-teaser__grid">
      <div class="story-teaser__media" data-parallax="-8">
        <Photo photo={s.story.photos[0]} ratio={4 / 5} widths={[400, 640, 900, 1200]} sizes="(min-width: 900px) 40vw, 100vw" />
      </div>
      <div>
        <SectionLabel num="06" text="Our story" />
        <h2 class="display h2 reveal-words" id="story-title" data-split-auto>{s.story.title}</h2>
        <p class="lead" data-reveal="fade">{s.story.lead}</p>
        <blockquote class="pull-quote" data-reveal="fade">
          <p>“{s.story.quote}”</p>
          <cite>{s.story.quoteBy}</cite>
        </blockquote>
        <a class="link-line" href="/our-story/" data-reveal="fade">Read our story <Icon name="arrow" class="btn__arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="gallery-title">
    <div class="container">
      <header class="section-head section-head--split">
        <div>
          <SectionLabel num="07" text="From the oven" />
          <h2 class="display h2 reveal-words" id="gallery-title" data-split-auto>Blistered, soft, gone in minutes.</h2>
        </div>
        {s.contact.social.instagram && (
          <a class="link-line" href={s.contact.social.instagram} target="_blank" rel="noopener" data-reveal="fade"><Icon name="instagram" class="btn__arrow" /> Follow us on Instagram</a>
        )}
      </header>
      <Gallery />
    </div>
  </section>
</Base>
