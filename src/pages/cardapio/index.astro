---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Menu from '../../components/Menu.astro';
import Icon from '../../components/Icon.astro';
import Decor from '../../components/Decor.astro';
import Cart from '../../components/Cart.astro';
import { site as s } from '../../data/site';
---
<Base title="Cardápio" path="/cardapio/" description={`Cardápio da ${s.name}: pizzas salgadas e doces, bordas recheadas e bebidas. Monte o pedido e envie pelo WhatsApp.`}>
  <PageHero label="Cardápio" title="Pizza salgada, pizza doce e borda recheada." lead="Escolha as pizzas, monte o pedido e envie direto pelo WhatsApp. O mesmo cardápio do salão, do delivery e do rodízio." />
  <section class="section section--tight menu-section" aria-label="Cardápio">
    <Decor items={[
      { x: 96, y: 22, size: 90, speed: 0.6 },
      { x: 2, y: 34, size: 40, speed: -0.6 },
      { x: 92, y: 46, size: 120, speed: 0.3 },
      { x: 3, y: 66, size: 100, speed: 0.4 },
      { x: 96, y: 86, size: 50, speed: -0.4 },
    ]} />
    <div class="container">
      <Menu />
      <div class="menu-cta" data-reveal="fade">
        <p>Quer essas pizzas na sua festa?</p>
        <a class="btn btn--primary" href="/contato/#orcamento" data-magnetic>Pedir orçamento <Icon name="arrow" class="btn__arrow" /></a>
      </div>
    </div>
  </section>
  <Cart />
</Base>
