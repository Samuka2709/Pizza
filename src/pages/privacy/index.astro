---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { site as s } from '../../data/site';
---
<Base title="Privacy & Cookies" path="/privacy/" description={`How ${s.name} uses your details and cookies.`}>
  <PageHero label="Privacy & cookies" title="Privacy notice" lead="Template for the design preview. The final text must be reviewed by the business before launch." />
  <section class="section section--tight">
    <div class="container prose">
      <h2>Who we are</h2>
      <p>{s.footer.copyright} ("we") runs this website. Contact: <a href={`mailto:${s.contact.email}`}>{s.contact.email}</a>.</p>
      <h2>What we collect</h2>
      <p>When you send the event enquiry form we receive your name, email, phone number, event date, location, type of event, number of guests and your message. We use them only to reply to your enquiry and, if you book, to organise your event.</p>
      <h2>How long we keep it</h2>
      <p>Enquiries that do not become bookings are deleted after 12 months. Booking records are kept as long as the law requires for accounting.</p>
      <h2>Cookies</h2>
      <p>This site only uses essential cookies or local storage, for example to remember that you closed the cookie notice. Maps are provided by Google and load only when you choose to show them; Google may then set its own cookies.</p>
      <h2>Your rights</h2>
      <p>You can ask to see, correct or delete your data at any time by emailing us. You can also complain to the Information Commissioner's Office (ico.org.uk).</p>
    </div>
  </section>
</Base>
