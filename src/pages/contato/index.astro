---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Icon from '../../components/Icon.astro';
import { site as s } from '../../data/site';
import { mailto, socialLinks, DAYS, popupTimes, whatsappLink } from '../../lib/format';
---
<Base title="Contato e orçamentos" path="/contato/" description={`Fale com a ${s.name}: pedidos pelo WhatsApp e orçamento para festas e eventos.`}>
  <PageHero label="Contato e orçamento" title="Vamos fazer a sua festa?" lead="Para pedidos do dia, chame no WhatsApp. Para festas e eventos, mande os detalhes e respondemos com um orçamento fechado." />

  <section class="section section--tight" id="orcamento" aria-labelledby="quote-title">
    <div class="container contact__grid">
      <div class="contact__form" data-reveal="fade">
        <h2 class="display h3" id="quote-title">Orçamento para festas</h2>
        <QuoteForm />
      </div>

      <aside class="contact__side" aria-label="Outras formas de contato">
        <div class="contact__card" data-reveal="fade">
          <h2 class="label">Prefere conversar?</h2>
          <a class="contact__big" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
          <a class="contact__big" href={`tel:${s.contact.phoneHref}`}><Icon name="phone" /> {s.contact.phone}</a>
          <a class="contact__big" href={mailto('Orçamento de festa')}><Icon name="mail" /> {s.contact.email}</a>
        </div>
        <div class="contact__card" data-reveal="fade">
          <h2 class="label">Siga a gente</h2>
          <ul class="contact__social">
            {socialLinks().map((l) => <li><a class="link-line" href={l.url} target="_blank" rel="noopener"><Icon name={l.key as 'instagram' | 'facebook' | 'tiktok'} class="btn__arrow" /> {l.label}</a></li>)}
          </ul>
        </div>
        <div class="contact__card" data-reveal="fade">
          <h2 class="label">Rodízio de sexta</h2>
          <p>Toda {DAYS[s.popup.weekday]}, {popupTimes()}<br />{s.popup.place}</p>
          <a class="link-line" href="/rodizio/">Mapa e como chegar <Icon name="arrow" class="btn__arrow" /></a>
        </div>
        <div class="contact__card" data-reveal="fade">
          <h2 class="label">Onde atendemos</h2>
          <p>{s.contact.serviceArea}</p>
        </div>
      </aside>
    </div>
  </section>
</Base>
