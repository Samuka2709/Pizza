---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" path="/404/">
  <PageHero label="404" title="This slice has already been eaten." lead="The page you were looking for is not here. Some old links from our previous site have moved.">
    <div class="page-hero__ctas">
      <a class="btn btn--primary" href="/">Back to home <Icon name="arrow" class="btn__arrow" /></a>
      <a class="btn btn--outline" href="/menu/">See the menu</a>
    </div>
  </PageHero>
</Base>
