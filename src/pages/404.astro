---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Página não encontrada" path="/404/">
  <PageHero label="404" title="Essa fatia já foi comida." lead="A página que você procura não está aqui.">
    <div class="page-hero__ctas">
      <a class="btn btn--primary" href="/">Voltar ao início <Icon name="arrow" class="btn__arrow" /></a>
      <a class="btn btn--outline" href="/cardapio/">Ver o cardápio</a>
    </div>
  </PageHero>
</Base>
